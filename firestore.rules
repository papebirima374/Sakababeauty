rules_version = '2';

// Règles de la base Sakaba. Toujours publier ce fichier EN ENTIER.
//
// equipe/{uid}   : les membres de l'équipe (role « directrice » ou « vendeuse »)
// produits/{id}  : prix, stock, code-barres (lecture publique : le site en a besoin)
// ventes/{id}    : ventes de la caisse (et plus tard commandes du site)
// mouvements/{id}: chaque entrée ou sortie de stock (qui, quand, combien)
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }
    function membre() {
      return connecte()
        && exists(/databases/$(database)/documents/equipe/$(request.auth.uid))
        && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.actif == true;
    }
    function role() {
      return get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.role;
    }
    function directrice() {
      return membre() && role() == "directrice";
    }

    match /equipe/{uid} {
      allow read: if (connecte() && request.auth.uid == uid) || directrice();
      allow write: if directrice();
    }

    match /produits/{id} {
      allow read: if true;
      // La directrice modifie tout. Une vendeuse ne touche qu'au stock
      // (une vente le fait baisser) et à la date de mise à jour.
      allow create, delete: if directrice();
      allow update: if directrice()
        || (membre()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stock", "majLe"]));
    }

    match /ventes/{id} {
      allow read: if membre();
      allow create: if membre()
        && request.resource.data.vendeuse.uid == request.auth.uid
        && request.resource.data.total is number
        && request.resource.data.lignes is list
        && request.resource.data.lignes.size() > 0;
      // Annulation d'une vente : directrice seulement. Jamais de suppression.
      allow update: if directrice();
      allow delete: if false;
    }

    match /mouvements/{id} {
      allow read: if membre();
      allow create: if membre() && request.resource.data.par == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
